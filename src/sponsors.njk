-->

<!-- HERO SECTION -->
<section class="hero hero--sponsors" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__content">
      <h1 id="hero-heading" class="hero__title">Our Sponsors</h1>
      <p class="hero__subtitle">Support from The Corporate World*</p>
      <p class="hero__description">
        Nobody is paying us. We made the ads anyway, on the theory that if you
        print a thing on a poster it eventually becomes true. So far this has
